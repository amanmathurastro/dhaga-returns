# Copy this file to .env (same folder) and fill in the values.
# The backend refuses to start if a required value is missing, and names it.

# --- Required -------------------------------------------------------------
OPENROUTER_API_KEY=
MODEL_A_ID=            # cheap model, TO DECIDE (must support structured output / tool calling)
MODEL_B_ID=            # stronger model, TO DECIDE (must support structured output / tool calling)
SUPABASE_DB_URL=       # server-side only. Postgres connection string from Supabase
CONFIDENCE_THRESHOLD=  # TO DECIDE after eval (0 to 1). Below this, Model A's answer is retried on Model B
MIN_RETURNS_TO_FLAG=   # TO DECIDE. A vendor needs at least this many returns for one reason to be flagged
LIFT_THRESHOLD=        # TO DECIDE. Flag when the vendor's rate is at least this many times the category average

# --- Frontend -------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Optional -------------------------------------------------------------
# Frontend URLs allowed to call the backend (comma-separated). Add the deployed frontend URL here.
FRONTEND_ORIGINS=http://localhost:3000
# Comments with fewer than this many letters/digits are treated as junk and never sent to a model.
JUNK_MIN_CHARS=3
# How many classification calls run at the same time (throughput only).
CLASSIFY_CONCURRENCY=8
# OpenRouter prices in USD per 1 million tokens. Leave blank and run cost shows as "not tracked".
MODEL_A_INPUT_USD_PER_MTOK=
MODEL_A_OUTPUT_USD_PER_MTOK=
MODEL_B_INPUT_USD_PER_MTOK=
MODEL_B_OUTPUT_USD_PER_MTOK=
